{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "bash": {
      "*": "ask",
      "git rev-parse *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git add -N *": "allow",
      "git reset -- *": "allow",
      "ls *": "allow",
      "jq *": "allow",
      "rg *": "allow",
      "printf *": "allow",
      "python3 .map/scripts/map_orchestrator.py *": "allow",
      "python3 .map/scripts/map_step_runner.py *": "allow",
      "xcodebuild *": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/Users/rpalkin/.config/opencode/**": "allow"
    }
  }
}
